# Copy to .env for local development. Only DATABASE_URL is required; the rest show their defaults.
# The database credentials match docker-compose.yml and are for local use only.
DATABASE_URL=postgres://ranker:ranker@localhost:5432/ranker
PORT=4000

# How long a stored weather forecast is served before it is refreshed.
FORECAST_TTL_SECONDS=3600
# How soon a failed marine (wave) fetch is retried. Never extends the TTL above.
MARINE_RETRY_SECONDS=300
# Timeout for each Open-Meteo request.
UPSTREAM_TIMEOUT_MS=3000
# Upstream operations (a geocode, or one refresh's weather and marine calls) at once per process.
# Beyond it a request is not queued: it gets stored data marked stale, or UPSTREAM_UNAVAILABLE.
UPSTREAM_MAX_CONCURRENT=10
# Time allowed to open a database connection, and Postgres statement_timeout for every query.
# Each bounds one step; together they are not an overall deadline for a request.
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000
# Most database connections per process. Keep instances × DB_POOL_MAX below Postgres max_connections.
DB_POOL_MAX=10

GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
FORECAST_BASE_URL=https://api.open-meteo.com
MARINE_BASE_URL=https://marine-api.open-meteo.com
