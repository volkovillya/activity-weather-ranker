{
  "name": "activity-weather-ranker",
  "version": "0.1.0",
  "private": true,
  "description": "GraphQL service that ranks the next 7 days for skiing, surfing and sightseeing using Open-Meteo forecasts.",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
